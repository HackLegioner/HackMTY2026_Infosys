{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "src/app/api/**/*": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/ws",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-transform" },
        { "key": "Connection", "value": "keep-alive" },
        { "key": "X-Accel-Buffering", "value": "no" }
      ]
    }
  ]
}
